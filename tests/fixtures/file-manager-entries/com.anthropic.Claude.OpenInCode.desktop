[Desktop Entry]
Type=Service
TryExec=/tmp/.mount_claudeOHhjmk/usr/lib/claude-desktop/claude-desktop
MimeType=inode/directory;
X-KDE-Protocols=file
Actions=openInClaudeCode
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-Claude-Generated=true

[Desktop Action openInClaudeCode]
Name=Open in Claude Code
Icon=claude-desktop
Exec="/tmp/.mount_claudeOHhjmk/usr/lib/claude-desktop/claude-desktop" --os-entry=folder_verb %f
